<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Fill in on the server. Don't commit real passwords. -->
    <add name="FMCGBIDB" connectionString="Provider=OraOLEDB.Oracle.1;Data Source=fmcgbidb;User ID=dwh;Password=CHANGE_ME" providerName="System.Data.OleDb" />
    <add name="APPSRO" connectionString="Provider=OraOLEDB.Oracle.1;Data Source=REVAMP;User ID=appsro;Password=CHANGE_ME" providerName="System.Data.OleDb" />
  </connectionStrings>

  <appSettings>
    <add key="Supplier.TemplateId" value="67" />
    <add key="Proc.Validate" value="DW_PROC_MDM_APP_VALID_SUP_NEW" />
    <add key="Proc.CreateApprovals" value="DW_PROC_MDM_APPROVALS" />
    <add key="Proc.ExecSteps" value="DW_PROC_MDM_EXEC_STEPS" />
    <!-- The creation procedure and operating units are set in the Admin tab (DW_MDM_APP_SUP_SETTINGS). -->

    <add key="Upload.Root" value="~/App_Data/Uploads" />
    <add key="Upload.MaxFormBytes" value="5242880" />
    <add key="Upload.MaxAttachmentBytes" value="10485760" />

    <!-- USER_ROLE values (DW_MDM_APP_USERS) that see the Admin tab. -->
    <add key="Admin.Roles" value="Admin,MDM_S" />
    <!-- Schemas a creation procedure may belong to. -->
    <add key="Admin.ProcedureOwners" value="DWH,APPS" />
  </appSettings>

  <system.web>
    <compilation debug="false" targetFramework="4.6.1" />
    <!-- 25 MB per request: one form plus a few documents. -->
    <httpRuntime targetFramework="4.6.1" maxRequestLength="25600" enableVersionHeader="false" />
    <customErrors mode="RemoteOnly" />
    <authentication mode="Windows" />
    <authorization>
      <deny users="?" />
    </authorization>
    <identity impersonate="false" />
    <httpCookies httpOnlyCookies="true" />
    <pages controlRenderingCompatibilityVersion="4.0" viewStateEncryptionMode="Always" enableViewStateMac="true" />
    <sessionState mode="InProc" cookieless="UseCookies" timeout="60" />
  </system.web>

  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="26214400" />
        <hiddenSegments>
          <add segment="sql" />
          <add segment="docs" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
